# Clean Sign server (Go)
# Run locally: `make run` (repo root). Copy this file to .env and fill in the values.

PORT=4000
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5433/cleansign?sslmode=disable

# Secret used for token signing and verification-code hashing (16+ chars). Use a long random value in production
JWT_SECRET=dev-only-secret-change-me-please

# Set to true to send cookies over https only (production)
COOKIE_SECURE=false

# Verification-code mail (for Gmail: smtp.gmail.com / 587 / app password).
# If SMTP_HOST is empty, no mail is sent and the code is written to the server log (local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI analysis server (ai-service/)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=        # same value as INTERNAL_TOKEN in ai-service
AI_SERVICE_TIMEOUT_MS=600000

# Analysis worker. By default the API server runs a worker itself (fine for local development and a single process).
# To run workers as separate processes, set WORKER_EMBEDDED=false on the API server.
WORKER_EMBEDDED=true
# How many analyses one worker runs at once (analysis is memory hungry, so keep it low)
WORKER_CONCURRENCY=1
# A separate worker process (`server worker`) needs only DATABASE_URL and the AI_SERVICE_* settings above.
# It does not apply migrations (the API server does) and answers /healthz on this port.
WORKER_HEALTH_PORT=4001
